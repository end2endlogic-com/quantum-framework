      {
        "id": "Customer",
        "parents": [
          "Party"
        ]
      },
      {
        "id": "PremiumCustomer",
        "parents": [
          "Customer"
        ]
      },
      {
        "id": "PurchaseOrder"
      },
      {
        "id": "POLine"
      },
      {
        "id": "Shipment"
      }
